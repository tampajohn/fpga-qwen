diff --git a/tools/profile_prefill_dispatch.py b/tools/profile_prefill_dispatch.py
new file mode 100644
index 0000000..0a71095
--- /dev/null
+++ b/tools/profile_prefill_dispatch.py
@@ -0,0 +1,102 @@
+"""Wall attribution of two explicit prefill profiles; no host neural arithmetic."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import tempfile
+import time
+import numpy as np
+from benchmark_matched import SVEngine, make_prompt
+from chat_protocol import ChatProtocol
+from experiment import locate_model
+from evaluate_projection_quality import validate_logits, model_provenance
+
+def read_dump_logits(model,path):
+    # These new profiling artifacts explicitly close/check before acknowledging.
+    # Do not issue the historical lanes barrier: it recreates the worker pool.
+    path=Path(path)
+    if model.command(f"dump {path}")!="dumped":raise RuntimeError("Invalid dump acknowledgement")
+    if path.stat().st_size!=151936*8:raise ValueError("Wrong full-vocabulary dump byte count")
+    return validate_logits(np.fromfile(path,dtype=np.float64))
+
+
+def phase(model, name, enabled, action, ticks, blocks, attention_tokens, heads):
+    model.command('profile off');model.command('profile reset')
+    model.command('profile on' if enabled else 'profile off')
+    start=time.perf_counter();result=action();elapsed=time.perf_counter()-start
+    counters=json.loads(model.command('profile off'))['categories']
+    total=counters['eval_tick']['nanoseconds']/1e9
+    dispatch=sum(v['nanoseconds'] for k,v in counters.items() if k!='eval_tick')/1e9
+    if enabled:
+        expected={'eval_tick':ticks,'qkv_group':28*blocks,'gate_up_group':28*blocks,
+                  'o':28*blocks,'down':28*blocks,'attention':28*attention_tokens,'vocabulary':heads}
+        for key,count in expected.items():
+            if counters[key]['calls']!=count:raise AssertionError((name,key,counters[key]['calls'],count))
+        if dispatch>total:raise AssertionError('Dispatch scopes exceed enclosing eval')
+    return result,dict(name=name,wall_seconds=elapsed,counters=counters,
+        eval_seconds=total if enabled else None,dispatch_seconds=dispatch if enabled else None,
+        residual_main_sv_wrappers_coordinator_seconds=total-dispatch if enabled else None,
+        outside_eval_transport_seconds=elapsed-total if enabled else None)
+
+
+def run(model,prompt,count,enabled):
+    model.command('profile off');model.reset()
+    def prefill():
+        for start in range(0,len(prompt)-1,8):model.prefill(prompt[start:min(start+8,len(prompt)-1)])
+    _,p=phase(model,'prefill',enabled,prefill,(len(prompt)+6)//8,(len(prompt)+6)//8,len(prompt)-1,0)
+    first,f=phase(model,'first_prediction',enabled,lambda:model.token(prompt[-1]),1,1,1,1)
+    ids=[first[0]]
+    def decode():
+        for _ in range(count-1):ids.append(model.token(ids[-1])[0])
+    _,d=phase(model,'decode',enabled,decode,count-1,count-1,count-1,count-1)
+    if any(t in (151643,151645) for t in ids):raise AssertionError('EOS invalidates workload')
+    return dict(enabled=enabled,output_ids=ids,phases=[p,f,d])
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--reference',type=Path,required=True);parser.add_argument('--candidate',type=Path,required=True)
+    parser.add_argument('--pairs',type=int,default=2);parser.add_argument('--tokens',type=int,default=16)
+    parser.add_argument('--output',type=Path,required=True);args=parser.parse_args()
+    if not 1<=args.pairs<=3 or not 2<=args.tokens<=32:parser.error('Invalid bounded workload')
+    checkpoint=locate_model(None);protocol=ChatProtocol(checkpoint)
+    paths=[args.reference.resolve(),args.candidate.resolve()]
+    profiles=['fp32_b1_fp64_prefill','fp32_b1_fp32_prefill']
+    engines=[SVEngine(checkpoint,8,protocol.tokenizer,p,8,block_size=1,prefill_size=8,precision_profile=profile,verification_capacity=4) for p,profile in zip(paths,profiles)]
+    def sha(p):return hashlib.file_digest(p.open('rb'),'sha256').hexdigest()
+    report=dict(source_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), completed=False,gpu=False,pytorch=False,binaries=[dict(path=str(p),sha256=sha(p),manifest=json.loads((p.parent.parent/'manifest.json').read_text())) for p in paths],model_provenance=model_provenance(checkpoint),profiles=[],
+        boundaries='Dispatch scopes enclose synchronous pool.run/run_group including transport, scheduling, SV worker evaluation and waits. Eval surrounds both clock edges. Residual includes main SV arithmetic, generated wrapper copies and coordinator work, NOT pure host overhead. Outside-eval wall includes IPC and Python transport. Group timings cannot split constituent Q/K/V or gate/up.',
+        limitations='Dynamic enabled/disabled comparison only measures instrumentation effects inside same executable; compiling timers can change code layout. Two resident models, OS caches warm, host drift possible. Diagnostic attribution, not optimization speed claim.')
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    try:
+        for e in engines:e.start()
+        report['metadata']=[e.metadata for e in engines]
+        with tempfile.TemporaryDirectory()as directory:
+            for workload in ('short','long'):
+                prompt=make_prompt(protocol,workload);entry=dict(workload=workload,prompt_ids=prompt,engines=[]);report['profiles'].append(entry)
+                for engine in engines:run(engine.model,prompt,args.tokens,False)
+                rows=[[],[]];references=[None,None]
+                for pair in range(args.pairs):
+                    for index in ((0,1) if pair%2==0 else (1,0)):
+                        for enabled in ((False,True) if pair%2==0 else (True,False)):
+                            row=run(engines[index].model,prompt,args.tokens,enabled)
+                            bits=read_dump_logits(engines[index].model,Path(directory)/'logits').tobytes()
+                            if references[index] is None:references[index]=(row['output_ids'],bits)
+                            if references[index]!=(row['output_ids'],bits):raise AssertionError('Profiler altered output/logit bits')
+                            row['pair']=pair;rows[index].append(row)
+                            print(workload,index,pair,enabled,flush=True)
+                if references[0][0]!=references[1][0]:raise AssertionError('Cross-profile greedy IDs differ')
+                for index,runs in enumerate(rows):
+                    overhead=[]
+                    for pair in range(args.pairs):
+                        by_mode={r['enabled']:r for r in runs if r['pair']==pair}
+                        overhead.append({a['name']:a['wall_seconds']/b['wall_seconds'] for a,b in zip(by_mode[True]['phases'],by_mode[False]['phases'])})
+                    entry['engines'].append(dict(profile=profiles[index],runs=runs,on_off_phase_wall_ratios=overhead,exact_on_off_logits=True))
+                args.output.write_text(json.dumps(report,indent=2)+'\n')
+        if any(sha(p)!=b['sha256'] for p,b in zip(paths,report['binaries'])):raise AssertionError('Binary changed')
+        report['completed']=True
+    finally:
+        for engine in engines:engine.close()
+        args.output.write_text(json.dumps(report,indent=2)+'\n')
+
+if __name__=='__main__':main()
