+#pragma once
+// Experimental transport-only wall timing. No neural arithmetic or worker timing.
+#ifdef PROFILE_DISPATCH
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <iostream>
+#include <unordered_map>
+namespace dispatch_profile {
+using Clock=std::chrono::steady_clock;
+inline bool enabled=false;
+inline constexpr int total=11;
+inline const char* names[]={"q","k","v","o","gate","up","down","vocabulary","attention","qkv_group","gate_up_group","eval_tick"};
+inline std::array<uint64_t,12> nanos{},calls{};
+inline std::unordered_map<int64_t,int> family;
+struct Scope {
+    int id; bool active; Clock::time_point begin;
+    explicit Scope(int category):id(category),active(enabled) {if(active)begin=Clock::now();}
+    ~Scope(){if(active){nanos[id]+=std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now()-begin).count();++calls[id];}}
+};
+inline int category(int64_t base){return family.at(base);}
+inline void output(){
+    std::cout<<"{\"enabled\":"<<(enabled?"true":"false")<<",\"categories\":{";
+    for(int i=0;i<12;++i){if(i)std::cout<<',';std::cout<<'"'<<names[i]<<"\":{\"calls\":"<<calls[i]<<",\"nanoseconds\":"<<nanos[i]<<'}';}
+    std::cout<<"}}\n"<<std::flush;
+}
+}
+#define PROFILE_SCOPE(id) dispatch_profile::Scope profile_scope(id)
+#define PROFILE_PROJECTION(base) dispatch_profile::Scope profile_scope(dispatch_profile::enabled?dispatch_profile::category(base):0)
+#else
+#define PROFILE_SCOPE(id) ((void)0)
+#define PROFILE_PROJECTION(base) ((void)0)
+#endif
