new file mode 100644
index 0000000..72e01b8
--- /dev/null
+++ b/test_regress/t/t_shortreal_subset.v
@@ -0,0 +1,81 @@
+// DESCRIPTION: Verilator: Experimental native binary32 storage and arithmetic
+// SPDX-FileCopyrightText: 2026 OpenAI
+// SPDX-License-Identifier: CC0-1.0
+module t (
+  input clk
+);
+  typedef shortreal sample_t;
+  sample_t a[3:1];
+  shortreal b[0:2];
+  shortreal product, total, rounded;
+  real wide;
+  int cyc = 0;
+  int index;
+  always @(posedge clk) begin
+    cyc = cyc + 1;
+    if (cyc == 1) begin
+      if ($bits(a[1]) != 32 || $bits(a) != 96 || $bits(wide) != 64) $stop;
+      a[1] = $bitstoshortreal(32'h3f800001);
+      b[0] = $bitstoshortreal(32'h3f7ffffe);
+      product = a[1] * b[0];
+      total = product + $bitstoshortreal(32'hbf800000);
+      if ($shortrealtobits(product) != 32'h3f800000) $stop;
+      if ($shortrealtobits(total) != 0) $stop;
+      wide = 16777217.0;
+      rounded = shortreal'(wide);
+      if ($shortrealtobits(rounded) != 32'h4b800000) $stop;
+      rounded = shortreal'(16777219.0);
+      if ($shortrealtobits(rounded) != 32'h4b800002) $stop;
+      rounded = shortreal'(-16777217.0);
+      if ($shortrealtobits(rounded) != 32'hcb800000) $stop;
+      rounded = shortreal'($bitstoreal(64'h3690000000000000));
+      if ($shortrealtobits(rounded) != 0) $stop;
+      rounded = shortreal'($bitstoreal(64'h36a8000000000000));
+      if ($shortrealtobits(rounded) != 2) $stop;
+      rounded = shortreal'(16777217.0);
+      wide = real'(rounded);
+      if ($realtobits(wide) != 64'h4170000000000000) $stop;
+      a[2] = $bitstoshortreal(32'h80000000);
+      if ($shortrealtobits(a[2]) != 32'h80000000) $stop;
+      a[3] = $bitstoshortreal(32'h00000001);
+      b[1] = $bitstoshortreal(32'h3f800000);
+      total = a[3] * b[1];
+      if ($shortrealtobits(total) != 32'h00000001) $stop;
+      b[2] = $bitstoshortreal(32'h7fc12345);
+      if ($shortrealtobits(b[2]) != 32'h7fc12345) $stop;
+      b[2] = $bitstoshortreal(32'h7f812345);
+      if ($shortrealtobits(b[2]) != 32'h7f812345) $stop;
+      index = cyc % 3;
+      a[index+1] = $bitstoshortreal(32'h3f000000);
+    end
+    if (cyc == 2) begin
+      index = (cyc-1) % 3;
+      if ($shortrealtobits(a[index+1]) != 32'h3f000000) $stop;
+      a[1] = $bitstoshortreal(32'h7f7fffff);
+      b[0] = $bitstoshortreal(32'h40000000);
+      total = a[1] * b[0];
+      if ($shortrealtobits(total) != 32'h7f800000) $stop;
+      total = shortreal'(0.0);
+      for (int i=1; i<=3; i++) begin
+        a[i] = shortreal'(i);
+        b[i-1] = shortreal'(2);
+        product = a[i] * b[i-1];
+        total = total + product;
+      end
+      if ($shortrealtobits(total) != 32'h41400000) $stop;
+      if ($bits(total + product) != 32) $stop;
+      wide = total + 0.25;
+      if ($realtobits(wide) != 64'h4028800000000000) $stop;
+    end
+    if (cyc == 3) begin
+      total = shortreal'(0.0);
+      for (int i=1; i<=3; i++) begin
+        product = a[i] * b[i-1];
+        total = total + product;
+      end
+      if ($shortrealtobits(total) != 32'h41400000) $stop;
+      $write("*-* All Finished *-*\n");
+      $finish;
+    end
+  end
+endmodule
