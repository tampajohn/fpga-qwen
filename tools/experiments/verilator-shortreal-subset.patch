diff --git a/src/V3Width.cpp b/src/V3Width.cpp
index c653e5b..fc2f2ce 100644
--- a/src/V3Width.cpp
+++ b/src/V3Width.cpp
@@ -455,6 +455,48 @@ class WidthVisitor final : public VNVisitor {
     void visit(AstNot* nodep) override { visit_negate_not(nodep, false); }
 
     // Real: inputs and output real
+    void checkShortRealOptions(AstNode* nodep) {
+        if (v3Global.opt.trace() || v3Global.opt.savable() || v3Global.opt.vpi()
+            || v3Global.opt.systemC())
+            nodep->v3error("Unsupported: shortreal trace/save/VPI/SystemC in experimental subset");
+    }
+    void visitFloatUnary(AstNodeUniop* nodep, bool bitsInput, bool floatOutput) {
+        checkShortRealOptions(nodep);
+        assertAtExpr(nodep);
+        if (m_vup->prelim()) {
+            userIterateAndNext(nodep->lhsp(), WidthVP{SELF, BOTH}.p());
+            if (bitsInput) {
+                if (!nodep->lhsp()->dtypep()->isIntegralOrPacked() || nodep->lhsp()->width() > 32)
+                    nodep->v3error("Unsupported: shortreal bitcast requires an integral input of at most 32 bits");
+            } else if (!nodep->lhsp()->isFloating()) {
+                nodep->v3error("Unsupported: shortreal conversion requires floating input");
+            }
+            if (floatOutput) nodep->dtypeSetFloat();
+            else if (VN_IS(nodep, ShortRealToBits)) nodep->dtypeSetUInt32();
+            else nodep->dtypeSetDouble();
+        }
+    }
+    void visit(AstBitsToRealF* nodep) override { visitFloatUnary(nodep, true, true); }
+    void visit(AstRealToShortRealF* nodep) override { visitFloatUnary(nodep, false, true); }
+    void visit(AstShortRealToRealD* nodep) override { visitFloatUnary(nodep, false, false); }
+    void visit(AstShortRealToBits* nodep) override {
+        visitFloatUnary(nodep, false, false);
+        spliceCvtF(nodep->lhsp());
+    }
+    void visitFloatBinary(AstNodeBiop* nodep) {
+        checkShortRealOptions(nodep);
+        assertAtExpr(nodep);
+        if (m_vup->prelim()) {
+            userIterateAndNext(nodep->lhsp(), WidthVP{SELF, BOTH}.p());
+            userIterateAndNext(nodep->rhsp(), WidthVP{SELF, BOTH}.p());
+            spliceCvtF(nodep->lhsp());
+            spliceCvtF(nodep->rhsp());
+            nodep->dtypeSetFloat();
+        }
+    }
