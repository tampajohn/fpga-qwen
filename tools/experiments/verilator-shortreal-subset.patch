 // Return double from QData (bits, not numerically)
+/// Reinterpret binary32 storage without a numerical conversion.
+inline float VL_CVT_F_I(IData value) VL_PURE {
+    float result;
+    std::memcpy(&result, &value, sizeof(result));
+    return result;
+}
+/// Reinterpret binary32 storage without a numerical conversion.
+inline IData VL_CVT_I_F(float value) VL_PURE {
+    IData result;
+    std::memcpy(&result, &value, sizeof(result));
+    return result;
+}
+
 inline double VL_CVT_D_Q(QData lhs) VL_PURE {
     union { double d; QData q; } u;
     u.q = lhs;
