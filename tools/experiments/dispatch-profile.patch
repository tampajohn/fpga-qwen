diff --git a/tools/profile_dispatch.py b/tools/profile_dispatch.py
new file mode 100644
index 0000000..71a8e89
--- /dev/null
+++ b/tools/profile_dispatch.py
@@ -0,0 +1,76 @@
+"""Opt-in dispatch wall attribution, with paired enabled/disabled overhead checks."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import statistics
+import tempfile
+import time
+from prefill_protocol import PrefillProtocolModel as RTLModel
+from chat_protocol import ChatProtocol
+from benchmark_matched import make_prompt
+from evaluate_projection_quality import read_dump_logits,model_provenance
+
+
+def request(model,prompt,count,enabled):
+    model.command('profile off');model.reset()
+    for start in range(0,len(prompt)-1,8):model.prefill(prompt[:-1][start:start+8])
+    pending=model.token(prompt[-1])[0]
+    model.command('profile reset');model.command('profile on' if enabled else 'profile off')
+    started=time.perf_counter();ids=[]
+    for _ in range(count):
+        pending=model.token(pending)[0];ids.append(pending)
+    elapsed=time.perf_counter()-started
+    model.command('profile off');counters=json.loads(model.command('profile read'))['categories']
+    total=counters['eval_tick']['nanoseconds'];dispatch=sum(v['nanoseconds']for k,v in counters.items()if k!='eval_tick')
+    if enabled:
+        if counters['eval_tick']['calls']!=count:raise RuntimeError('Wrong eval tick count')
+        for name in ('q','k','v','o','gate','up','down','attention'):
+            if counters[name]['calls']!=28*count:raise RuntimeError(f'Wrong {name} dispatch count')
+        if counters['vocabulary']['calls']!=count:raise RuntimeError('Wrong head count')
+        if dispatch>total:raise RuntimeError('Nested dispatch timing exceeds enclosing tick')
+    return dict(enabled=enabled,host_decode_seconds=elapsed,decode_tokens=count,output_ids=ids,counters=counters,
+                eval_tick_seconds=total/1e9,dispatch_sum_seconds=dispatch/1e9,
+                residual_main_sv_wrapper_coordinator_seconds=(total-dispatch)/1e9,
+                host_outside_eval_seconds=elapsed-total/1e9 if enabled else None)
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--binary',type=Path,required=True)
+    parser.add_argument('--tokens',type=int,default=32)
+    parser.add_argument('--pairs',type=int,default=3)
+    parser.add_argument('--output',type=Path,default=Path('build/dispatch-profile.json'))
+    args=parser.parse_args()
+    model=RTLModel(binary=args.binary,workers=8,lanes=8,block_size=4)
+    report=dict(binary=str(args.binary.resolve()),binary_sha256=hashlib.sha256(args.binary.read_bytes()).hexdigest(),
+                gpu=False,pytorch=False,workers=8,lanes=8,prefill_size=8,profiles={},
+                boundaries='Dispatch scopes surround synchronous pool.run/run_group only. Includes scheduling, transport into workers, SV worker evaluation and wait. Eval tick surrounds both main d->eval calls; includes all dispatches. Residual is main SV arithmetic plus generated wrappers/copies, dispatch classification and coordinator work, not pure scheduling. Host outside eval includes IPC, parsing/output and Python overhead.',
+                limitations='Wall time, not sum of worker CPU. Profiling may perturb scheduling/codegen. Dynamic on/off pairs bound instrumentation overhead within the same executable; do not prove no codegen change against production.')
+    try:
+        model.start();protocol=ChatProtocol(model.model)
+        report['model_provenance']=model_provenance(model.model)
+        report['build_manifest']=json.loads((args.binary.parent.parent/'manifest.json').read_text())
+        with tempfile.TemporaryDirectory() as directory:
+            for profile in ('short','long'):
+                prompt=make_prompt(protocol,profile);request(model,prompt,args.tokens,False)
+                runs=[];reference=None;reference_logits=None
+                for pair in range(args.pairs):
+                    for enabled in ((False,True)if pair%2==0 else(True,False)):
+                        row=request(model,prompt,args.tokens,enabled)
+                        logits=read_dump_logits(model,Path(directory)/'logits.bin')
+                        bits=logits.view('uint64')
+                        if reference is None:reference=row['output_ids'];reference_logits=bits.copy()
+                        if row['output_ids']!=reference or not (bits==reference_logits).all():raise AssertionError('Profiling changed output/logits')
+                        row['pair']=pair;runs.append(row)
+                overhead=[]
+                for pair in range(args.pairs):
+                    rows={r['enabled']:r for r in runs if r['pair']==pair}
+                    overhead.append(rows[True]['host_decode_seconds']/rows[False]['host_decode_seconds'])
+                report['profiles'][profile]=dict(prompt_tokens=len(prompt),prompt_ids=prompt,runs=runs,
+                    enabled_over_disabled_wall_ratios=overhead,median_overhead_ratio=statistics.median(overhead),exact_final_logits_and_ids=True)
+                args.output.parent.mkdir(parents=True,exist_ok=True);args.output.write_text(json.dumps(report,indent=2)+'\n')
+                print(profile,overhead,flush=True)
+    finally:model.close()
+
+if __name__=='__main__':main()
