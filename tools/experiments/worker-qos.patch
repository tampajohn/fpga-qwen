+#pragma once
+// Optional scheduling experiment only; no model arithmetic or core affinity.
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#ifdef __APPLE__
+#include <pthread/qos.h>
+#endif
+namespace experimental_worker_qos {
+enum class Selection { unchanged, default_class, user_initiated };
+inline Selection parse(const char* value) {
+    if(!value || !*value) return Selection::unchanged;
+    if(std::strcmp(value,"DEFAULT")==0)return Selection::default_class;
+    if(std::strcmp(value,"USER_INITIATED")==0)return Selection::user_initiated;
+    throw std::runtime_error("QWEN_EXPERIMENTAL_WORKER_QOS must be DEFAULT or USER_INITIATED (or unset)");
+}
+inline const char* name(Selection value) {
+    return value==Selection::unchanged?"UNCHANGED":value==Selection::default_class?"DEFAULT":"USER_INITIATED";
+}
+struct Observation { int requested_class=-1; int relative_priority=0; };
+inline Observation observe() {
+#ifdef __APPLE__
+    qos_class_t value;int relative;
+    int error=pthread_get_qos_class_np(pthread_self(),&value,&relative);
+    if(error)throw std::runtime_error("pthread_get_qos_class_np failed: "+std::to_string(error));
+    return {int(value),relative};
+#else
+    return {};
+#endif
+}
+inline Observation configure(Selection selection) {
+#ifdef __APPLE__
+    if(selection!=Selection::unchanged) {
+        const auto desired=selection==Selection::default_class?QOS_CLASS_DEFAULT:QOS_CLASS_USER_INITIATED;
+        int error=pthread_set_qos_class_self_np(desired,0);
+        if(error)throw std::runtime_error("pthread_set_qos_class_self_np failed: "+std::to_string(error));
+        auto actual=observe();
+        if(actual.requested_class!=int(desired) || actual.relative_priority!=0)
+            throw std::runtime_error("Worker QoS readback differs from requested class");
+        return actual;
+    }
+#else
+    if(selection!=Selection::unchanged)throw std::runtime_error("Explicit worker QoS experiment requires Apple pthread QoS APIs");
+#endif
+    return observe();
+}
+}
