diff --git a/tests/test_worker_qos.py b/tests/test_worker_qos.py
new file mode 100644
index 0000000..1c4ab5a
--- /dev/null
+++ b/tests/test_worker_qos.py
@@ -0,0 +1,52 @@
+"""Scheduling helper checks only; no model math or performance measurements."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+ROOT=Path(__file__).resolve().parents[1]
+SOURCE=r'''
+#include "experimental_worker_qos.h"
+#include <thread>
+#include <iostream>
+int main() {
+ try {
+  using namespace experimental_worker_qos;
+  auto selection=parse(std::getenv("QWEN_EXPERIMENTAL_WORKER_QOS"));
+  auto before=observe();Observation actual;std::exception_ptr error;
+  std::thread worker([&]{try{actual=configure(selection);}catch(...){error=std::current_exception();}});
+  worker.join();if(error)std::rethrow_exception(error);
+  auto after=observe();
+  std::cout<<"{\"before\":"<<before.requested_class<<",\"after\":"<<after.requested_class
+           <<",\"worker\":"<<actual.requested_class<<",\"relative\":"<<actual.relative_priority<<"}";
+ }catch(const std::exception& error){std::cerr<<error.what();return 1;}
+}
+'''
+class WorkerQoSTests(unittest.TestCase):
+ @classmethod
+ def setUpClass(cls):
+  cls.directory=tempfile.TemporaryDirectory();root=Path(cls.directory.name)
+  source=root/'probe.cpp';source.write_text(SOURCE);cls.binary=root/'probe'
+  subprocess.run(['c++','-std=c++17','-pthread','-I'+str(ROOT/'sim'),str(source),'-o',str(cls.binary)],check=True,capture_output=True)
+ @classmethod
+ def tearDownClass(cls):cls.directory.cleanup()
+ def run_selector(self,value):
+  env=os.environ.copy();env.pop('QWEN_EXPERIMENTAL_WORKER_QOS',None)
+  if value is not None:env['QWEN_EXPERIMENTAL_WORKER_QOS']=value
+  return subprocess.run([str(self.binary)],env=env,text=True,capture_output=True)
+ def test_invalid_selector(self):
+  for value in ('user_initiated','BACKGROUND','DEFAULT ','1'):
+   result=self.run_selector(value);self.assertEqual(result.returncode,1);self.assertIn('must be DEFAULT or USER_INITIATED',result.stderr)
+ def test_unchanged(self):
+  result=self.run_selector(None);self.assertEqual(result.returncode,0,result.stderr)
+  data=json.loads(result.stdout);self.assertEqual(data['before'],data['after'])
+ def test_explicit_readback(self):
+  for selector,expected in (('DEFAULT',21),('USER_INITIATED',25)):
+   result=self.run_selector(selector)
+   if sys.platform!='darwin':self.assertEqual(result.returncode,1);continue
+   self.assertEqual(result.returncode,0,result.stderr);data=json.loads(result.stdout)
+   self.assertEqual(data['worker'],expected);self.assertEqual(data['relative'],0)
+   self.assertEqual(data['before'],data['after'])
+if __name__=='__main__':unittest.main()
