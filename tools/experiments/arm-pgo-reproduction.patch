diff --git a/tools/train_pgo.py b/tools/train_pgo.py
new file mode 100644
index 0000000..7dd87c1
--- /dev/null
+++ b/tools/train_pgo.py
@@ -0,0 +1,75 @@
+"""Bounded instrumentation training; its elapsed time is not a performance result."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import threading
+import time
+
+try:
+    from .rtl_chat import RTLChatEngine
+except ImportError:
+    from rtl_chat import RTLChatEngine
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--binary',type=Path,required=True)
+    parser.add_argument('--output',type=Path,required=True)
+    parser.add_argument('--model')
+    args=parser.parse_args()
+    binary=args.binary.resolve()
+    build=json.loads((binary.parent.parent/'manifest.json').read_text())
+    if not build['options'].get('pgo_generate') or build['options'].get('cpu')!='generic':
+        parser.error('Use a generic-target instrumentation build')
+    raw_directory=Path(build['options']['pgo_generate']).resolve()
+    previous=set(raw_directory.glob('*.profraw'))
+    engine=RTLChatEngine(args.model,workers=1,binary=binary,lanes=8,block_size=4)
+    cases=[
+        ('greedy','Describe how a queue and a stack differ. Give two examples.',24,'greedy',0),
+        ('sampled_suffix','Continue the pattern without explanation: red blue green red blue green red blue green',24,'chat',3),
+        ('long_code',('A queue holds pending requests in arrival order. A worker takes the oldest request. '*8)+
+         'Write a short Python function to reverse a list without modifying its input.',16,'chat',3),
+    ]
+    records=[]
+    started=time.perf_counter()
+    try:
+        for label,prompt,count,decoding,draft in cases:
+            request=engine.prepare(dict(session='pgo-training-'+label,messages=[dict(role='user',content=prompt)],
+                max_new_tokens=count,decoding=decoding,seed=42,max_draft=draft))
+            done=None
+            for event in engine.stream(request,threading.Event()):
+                if event['type']=='error':raise RuntimeError(event)
+                if event['type']=='done':done=event
+            if done is None:raise RuntimeError('Missing completion')
+            records.append(dict(label=label,prompt=prompt,prompt_ids=request.ids,decoding=decoding,
+                                requested_max_draft=draft,metrics=done['metrics'],text=done['text']))
+            print(json.dumps(dict(training_case=label,prompt_tokens=len(request.ids),metrics=done['metrics'])),flush=True)
+        # The profile runtime writes at normal exit; SIGTERM would discard data.
+        process=engine.sim.process
+        process.stdin.write('quit\n');process.stdin.flush()
+        if process.wait(timeout=60)!=0:raise RuntimeError('Instrumented model did not exit cleanly')
+    finally:
+        engine.close()
+    raw=sorted(set(raw_directory.glob('*.profraw'))-previous)
+    if not raw:raise RuntimeError('No new raw profiles; require normal process exit')
+    output=args.output.resolve();output.parent.mkdir(parents=True,exist_ok=True)
+    command=['xcrun','llvm-profdata','merge','-o',str(output),*map(str,raw)]
+    subprocess.run(command,check=True)
+    with (engine.sim.model/'model.safetensors').open('rb') as checkpoint:
+        checkpoint_sha=hashlib.file_digest(checkpoint,'sha256').hexdigest()
+    profile=dict(checkpoint_sha256=checkpoint_sha,profile_sha256=hashlib.sha256(output.read_bytes()).hexdigest(),
+                 build_sources=build['sources'],training_binary_sha256=build['binary_sha256'],
+                 compiler=build['compiler'],verilator=build['verilator'],training_workers=1,
+                 counter_update=build['options']['pgo_update'],
+                 limitation='Single projection worker avoids contended non-atomic shared counters; eight-worker scheduling frequencies are not representative.',
+                 training_seconds_not_benchmark=time.perf_counter()-started,training_cases=records,
+                 training_script_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+                 raw_profiles=[dict(name=p.name,sha256=hashlib.sha256(p.read_bytes()).hexdigest())for p in raw],
+                 merge_command=command,llvm_profdata=subprocess.check_output(['xcrun','llvm-profdata','--version'],text=True).strip())
+    Path(str(output)+'.manifest.json').write_text(json.dumps(profile,indent=2)+'\n')
+    print(output,flush=True)
+
+
+if __name__=='__main__':main()
