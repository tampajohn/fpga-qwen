+"""Bounded projection-only streaming feasibility probe; no full-model claims."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from tools.rtl_model import RTLModel
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--binary',type=Path,required=True)
+    p.add_argument('--reference',type=Path,required=True)
+    args=p.parse_args()
+    paths=[args.reference.resolve(),args.binary.resolve()]
+    models=[RTLModel(binary=path,workers=8,lanes=8) for path in paths]
+    report=dict(binary_sha256=[hashlib.sha256(path.read_bytes()).hexdigest() for path in paths],
+                labels=['native_neon','native_streaming_annotation'],workers=8,lanes=8,runs=[],
+                limits=['Projection bench only; no full-model correctness or throughput claim.',
+                        'Existing bench exposes first/last outputs, not every projection element.',
+                        'Two paired samples per shape; startup excluded.'])
+    try:
+        for m in models:m.start()
+        for name,slot,rows,width in [('q',4,2048,1024),('down',13,1024,3072),('vocabulary',2,151936,1024)]:
+            command=f'bench {slot} {rows} {width} 5'
+            for m in models:m.command(command)
+            for pair,order in enumerate(((0,1),(1,0))):
+                samples={}
+                for i in order:
+                    values=models[i].command(command).split()
+                    samples[str(i)]=dict(seconds=float(values[0]),first=values[1],last=values[2])
+                assert (samples['0']['first'],samples['0']['last'])==(samples['1']['first'],samples['1']['last'])
+                row=dict(shape=name,pair=pair,order=order,samples=samples,baseline_over_candidate=samples['0']['seconds']/samples['1']['seconds'])
+                report['runs'].append(row);print(json.dumps(row),flush=True)
+    finally:
+        for m in models:m.close()
+        Path('build/streaming-projection.json').write_text(json.dumps(report,indent=2)+'\n')
+
+
+if __name__=='__main__':main()
