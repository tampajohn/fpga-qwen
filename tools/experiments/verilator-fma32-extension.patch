diff --git a/test_regress/t/t_shortreal_fma.v b/test_regress/t/t_shortreal_fma.v
new file mode 100644
index 0000000..b3ffbcd
--- /dev/null
+++ b/test_regress/t/t_shortreal_fma.v
@@ -0,0 +1,73 @@
+// DESCRIPTION: Verilator: Explicit experimental binary32 FMA extension
+// SPDX-FileCopyrightText: 2026 OpenAI
+// SPDX-License-Identifier: CC0-1.0
+// verilog_format: off
+`define stop $stop
+`define checkh(gotv,expv) do if ((gotv) !== (expv)) begin $write("%%Error: %s:%0d: got=%0h expected=%0h\n", `__FILE__, `__LINE__, (gotv), (expv)); `stop; end while(0);
+// verilog_format: on
+module t (
+  input clk
+);
+  typedef shortreal sample_t;
+  sample_t operands[3:1];
+  shortreal fused, product, separate;
+  logic [31:0] abits, bbits, cbits, expected, actual;
+  int cyc = 0;
+  int index;
+  logic [31:0] random_bits = 32'h5a17c0de;
+  always @(posedge clk) begin
+    case (cyc)
+      0: begin abits=32'h3f800001; bbits=32'h3f7ffffe; cbits=32'hbf800000; expected=32'ha8800000; end
+      1: begin abits=32'h3f800000; bbits=32'h3f800000; cbits=32'h33800000; expected=32'h3f800000; end
+      2: begin abits=32'h3f800001; bbits=32'h3f800000; cbits=32'h33800000; expected=32'h3f800002; end
+      3: begin abits=32'h00000001; bbits=32'h3f000000; cbits=32'h00000000; expected=32'h00000000; end
+      4: begin abits=32'h00000001; bbits=32'h3f000000; cbits=32'h00000001; expected=32'h00000002; end
+      5: begin abits=32'h80000001; bbits=32'h3f000000; cbits=32'h00000000; expected=32'h80000000; end
+      6: begin abits=32'h3f800000; bbits=32'h3f800000; cbits=32'hbf800000; expected=32'h00000000; end
+      7: begin abits=32'h7f7fffff; bbits=32'h40000000; cbits=32'hff7fffff; expected=32'h7f7fffff; end
+      8: begin abits=32'h7f7fffff; bbits=32'h40000000; cbits=32'h00000000; expected=32'h7f800000; end
+      9: begin abits=32'hff7fffff; bbits=32'h40000000; cbits=32'h00000000; expected=32'hff800000; end
+      10: begin abits=32'h80000000; bbits=32'h3f800000; cbits=32'h80000000; expected=32'h80000000; end
+      11: begin abits=32'h80000000; bbits=32'hbf800000; cbits=32'h80000000; expected=32'h00000000; end
+      12: begin abits=32'h7f800000; bbits=32'hbf800000; cbits=32'h00000000; expected=32'hff800000; end
+      13: begin abits=32'h3f800000; bbits=32'h3f800000; cbits=32'h7f800000; expected=32'h7f800000; end
+      14: begin abits=32'h7f800000; bbits=32'h00000000; cbits=32'h00000000; expected=0; end
+      15: begin abits=32'h7f800000; bbits=32'h3f800000; cbits=32'hff800000; expected=0; end
+      16: begin abits=32'h7fc12345; bbits=32'h3f800000; cbits=32'h00000000; expected=0; end
+      17: begin abits=32'h7f812345; bbits=32'h3f800000; cbits=32'h00000000; expected=0; end
+      default: begin
+        random_bits = (random_bits ^ (random_bits << 13));
+        random_bits = (random_bits ^ (random_bits >> 17));
+        random_bits = (random_bits ^ (random_bits << 5));
+        abits = random_bits & 32'hff7fffff;
+        random_bits = random_bits * 32'd1664525 + 32'd1013904223;
+        bbits = random_bits & 32'hff7fffff;
+        random_bits = random_bits * 32'd1664525 + 32'd1013904223;
+        cbits = random_bits & 32'hff7fffff;
+        expected=0;
+      end
+    endcase
+    index = cyc % 3 + 1;
+    operands[index] = $bitstoshortreal(abits);
+    fused = $verilator_fma32(operands[index], $bitstoshortreal(bbits), $bitstoshortreal(cbits));
+    actual = $shortrealtobits(fused);
+    if (cyc < 14) begin
+      `checkh(actual, expected);
+    end else if (cyc < 18) begin
+      `checkh(actual[30:23], 8'hff);
+      if (actual[22:0] == 0) `stop;
+    end
+    $display("FMA32 %08x %08x %08x %08x", abits, bbits, cbits, actual);
+    if (cyc == 0) begin
+      product = operands[index] * $bitstoshortreal(bbits);
+      separate = product + $bitstoshortreal(cbits);
+      `checkh($shortrealtobits(separate), 32'h00000000);
+      `checkh($bits(fused), 32);
+    end
+    if (cyc == 273) begin
+      $write("*-* All Finished *-*\n");
+      $finish;
+    end
+    cyc = cyc + 1;
+  end
+endmodule
