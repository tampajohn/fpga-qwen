diff --git a/rtl/fp32_projection_kernel.sv b/rtl/fp32_projection_kernel.sv
index 7d0329a..745ee83 100644
--- a/rtl/fp32_projection_kernel.sv
+++ b/rtl/fp32_projection_kernel.sv
@@ -17,10 +17,26 @@ module fp32_projection_kernel(
     shortreal partial[8][B];
     shortreal totals[B];
     shortreal weight;
+// Only the independent token updates are grouped. Column accumulation and
+// final lane reduction retain their original order and explicit FP32 rounding.
+`ifdef FP32_TOKEN_QUADS
+    initial if(B!=8) $fatal(1,"FP32_TOKEN_QUADS requires batch eight");
+`define TOKEN_UPDATE(lane, token) \
+    partial[lane][token]=shortreal'(partial[lane][token]+shortreal'(converted[((column+lane)*B+(token))&(4096*B-1)]*weight));
+`define STEP(lane) \
+    weight=shortreal'(weight_value_unchecked(base+longint'(row)*width+longint'(column+lane))); \
+    for(int group_id=0;group_id<2;group_id++) begin \
+        `TOKEN_UPDATE(lane, (4*group_id+0)) \
+        `TOKEN_UPDATE(lane, (4*group_id+1)) \
+        `TOKEN_UPDATE(lane, (4*group_id+2)) \
+        `TOKEN_UPDATE(lane, (4*group_id+3)) \
+    end
+`else
 `define STEP(lane) \
     weight=shortreal'(weight_value_unchecked(base+longint'(row)*width+longint'(column+lane))); \
     for(int t=0;t<B;t++) \
         partial[lane][t]=shortreal'(partial[lane][t]+shortreal'(converted[((column+lane)*B+t)&(4096*B-1)]*weight));
+`endif
     always @(posedge clk) begin
         if(start) begin
             for(int unsigned column=0;column<width;column++)
@@ -49,4 +65,7 @@ module fp32_projection_kernel(
         end
     end
 `undef STEP
+`ifdef FP32_TOKEN_QUADS
+`undef TOKEN_UPDATE
+`endif
 endmodule
